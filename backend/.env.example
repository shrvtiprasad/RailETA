# Copy this file to backend/.env. Never commit backend/.env.

# Public API controls. Leave authentication disabled for local frontend work;
# enable it in a deployment and send X-API-Key with every /api/v1 request.
RAILETA_REQUIRE_API_KEY=false
RAILETA_PUBLIC_API_KEY=
RAILETA_RATE_LIMIT_PER_MINUTE=60
# Local-only account identity for the key-management page. Set
# RAILETA_REQUIRE_ACCOUNT_AUTH=true in deployments with real user auth.
RAILETA_REQUIRE_ACCOUNT_AUTH=false
RAILETA_DEVELOPMENT_ACCOUNT_ID=local-development-account
# Comma-separated browser origins allowed to call the API.
RAILETA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Live current-position data used by the existing RailRadar route.
RAILRADAR_API_KEY=
# Optional trusted PEM CA bundle for systems/proxies with a private certificate chain.
# Leave blank for the OS trust store (macOS/Windows) with certifi fallback; never disable verification.
# RAILRADAR_CA_BUNDLE=/absolute/path/to/trusted-ca.pem

# RailKit is used only by the explicit historical-data pipeline command.
RAILKIT_API_KEY=
RAILKIT_MAX_MONTHLY_REQUESTS=0
RAILKIT_SAFETY_BUFFER_REQUESTS=5
# Optional provider-dashboard snapshot. Keep this updated if the account balance changes.
# RAILKIT_PROVIDER_REMAINING_REQUESTS=

# Open-Meteo is public; these URLs are configurable for reproducible deployments.
OPEN_METEO_HISTORICAL_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# Optional trusted PEM CA bundle for managed networks; leave blank normally.
# OPEN_METEO_CA_BUNDLE=/absolute/path/to/trusted-ca.pem

# Automatic connection-risk assumptions. A station-specific JSON override is
# optional; no station transfer data is currently present in the local source.
RAILETA_DEFAULT_MINIMUM_TRANSFER_MINUTES=10
RAILETA_CONNECTION_MEDIUM_MARGIN_MINUTES=20
# RAILETA_STATION_TRANSFER_MINUTES_JSON={"NDLS":15}

# Optional local paths for the quota-aware RailKit importer.
# RAILKIT_CACHE_DIR=backend/ml/data/raw/railkit
# RAILKIT_USAGE_FILE=backend/data/railkit_usage.json
# RAILKIT_UNAVAILABLE_FILE=backend/ml/data/railkit_unavailable.csv
